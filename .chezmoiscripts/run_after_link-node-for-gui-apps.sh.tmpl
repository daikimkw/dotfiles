#!/bin/bash

# {{ if eq .chezmoi.os "darwin" }}
set -eu

# GUI apps (Xcode, etc.) are launched by launchd and never read ~/.zshrc, so the
# mise activation there is invisible to them. React Native's "Bundle React Native
# code and images" build phase only does `export PATH=<brew bin>:$PATH`, which is
# why `node` cannot be found from Xcode.
#
# Expose the mise shim under the Homebrew bin dir. The shim (not a fixed version
# path) is used on purpose: mise resolves the node version from the project's
# mise.toml / mise.local.toml at build time.

# {{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "daikimkw-pc-1") }}
eval "$(/opt/homebrew/bin/brew shellenv)"
# {{ else }}
eval "$({{ .chezmoi.homeDir }}/homebrew/bin/brew shellenv)"
# {{ end }}

shim="$HOME/.local/share/mise/shims/node"
link="$(brew --prefix)/bin/node"

[ -x "$shim" ] || exit 0

if [ -L "$link" ]; then
  # Only touch links we own; leave anything else alone.
  [ "$(readlink "$link")" = "$shim" ] || ln -sfn "$shim" "$link"
elif [ -e "$link" ]; then
  echo "skip: $link already exists and is not a symlink (brew-installed node?)" >&2
else
  ln -s "$shim" "$link"
fi
# {{ end }}
