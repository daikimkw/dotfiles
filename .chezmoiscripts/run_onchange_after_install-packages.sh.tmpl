#!/bin/bash

# {{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "daikimkw-pc-1") }}
eval "$(/opt/homebrew/bin/brew shellenv)"
# {{ else if eq .chezmoi.os "darwin" }}
eval "$({{ .chezmoi.homeDir }}/homebrew/bin/brew shellenv)"
# {{ else if eq .chezmoi.os "linux" }}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
# {{ end }}

# Brewfile hash: {{ include "dot_Brewfile.tmpl" | sha256sum }}

brew bundle --file="$HOME/.Brewfile"

# brew bundle installs missing extensions but never upgrades existing ones, so
# pull them all up to their latest versions afterwards. --update-extensions does
# the whole set in a single process; looping --install-extension --force would
# spawn one code process per extension for the same result.
if command -v code &>/dev/null; then
  code --update-extensions || true
fi
