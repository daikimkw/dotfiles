#!/bin/sh
# Create a fresh herdr workspace rooted at the given directory (default: $PWD)
# and split it into a 2-row x 3-column grid (6 panes), leaving the top-left
# pane focused. Talks to the running herdr server over its socket API.
#
#   herdr-6pane [dir]
#
# Invoked by the `herdr` shell wrapper before it attaches to the session.
set -e

cwd=${1:-$PWD}
label=$(basename "$cwd")

field() { jq -r "$1"; }

root=$(herdr workspace create --cwd "$cwd" --label "$label" --focus | field '.result.root_pane.pane_id')
if [ -z "$root" ] || [ "$root" = null ]; then
  echo "herdr-6pane: failed to create workspace" >&2
  exit 1
fi

# Three equal columns: the left pane keeps 1/3, then the remaining 2/3 is
# halved into the middle and right columns.
c2=$(herdr pane split "$root" --direction right --ratio 0.333 --cwd "$cwd" --no-focus | field '.result.pane.pane_id')
c3=$(herdr pane split "$c2"   --direction right --ratio 0.5   --cwd "$cwd" --no-focus | field '.result.pane.pane_id')

# Two equal rows in each column.
for col in "$root" "$c2" "$c3"; do
  herdr pane split "$col" --direction down --ratio 0.5 --cwd "$cwd" --no-focus >/dev/null
done
