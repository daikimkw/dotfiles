#!/usr/bin/ruby
# frozen_string_literal: true

# Launch a Ghostty window from a Warp-style launch configuration YAML.
# Walks the pane tree and drives Ghostty's AppleScript automation API so
# nested grids and per-pane cwd are reproduced faithfully.
#
#   ghostty-launch ~/.config/ghostty/launch_configurations/icuco.yaml

require "yaml"
require "tempfile"

abort "usage: ghostty-launch <config.yaml>" if ARGV.empty?
config = YAML.load_file(ARGV[0])

LINES = []
def emit(line)
  LINES << line
end

def asq(str)
  %("#{str.to_s.gsub('\\', '\\\\\\\\').gsub('"', '\\"')}")
end

def expand(path)
  return nil if path.nil?
  path.sub(/\A~/, ENV["HOME"])
end

def map_dir(direction)
  # Warp semantics: vertical = stack top/bottom, horizontal = side by side.
  direction == "horizontal" ? "right" : "down"
end

def first_leaf_cwd(node)
  return expand(node["cwd"]) if node["cwd"]
  (node["panes"] || []).each do |child|
    found = first_leaf_cwd(child)
    return found if found
  end
  nil
end

$counter = 0
$focus_pane = nil
$focus_tab = nil

# Reuse a single surface configuration object, updating its cwd per pane,
# to minimize Apple Events (faster than creating one config per pane).
def new_cfg(cwd)
  emit "set initial working directory of cfg to #{asq(cwd || ENV['HOME'])}"
  "cfg"
end

def new_pane_var
  $counter += 1
  "p#{$counter}"
end

# Render `node` into the already-existing `pane_var`. Returns the
# representative (first-leaf) pane var of the node's region.
def render(node, pane_var, tab_var)
  (node["commands"] || []).each do |cmd|
    next unless cmd["exec"]
    emit "input text #{asq(cmd['exec'])} to #{pane_var}"
    emit "send key \"enter\" to #{pane_var}"
  end

  panes = node["panes"]
  if panes.nil? || panes.empty?
    if node["is_focused"]
      $focus_pane = pane_var
      $focus_tab = tab_var
    end
    return pane_var
  end

  dir = map_dir(node["split_direction"])

  # Create every sibling region first (full span on the cross axis),
  # then recurse so inner splits don't shrink the wrong area.
  region_vars = [pane_var]
  prev = pane_var
  panes.each_with_index do |child, i|
    next if i.zero?
    cfg = new_cfg(first_leaf_cwd(child))
    pv = new_pane_var
    emit "set #{pv} to split #{prev} direction #{dir} with configuration #{cfg}"
    region_vars << pv
    prev = pv
  end

  panes.each_with_index { |child, i| render(child, region_vars[i], tab_var) }
  region_vars[0]
end

emit 'set wasRunning to application "Ghostty" is running'
emit 'tell application "Ghostty"'
emit "  if not wasRunning then launch"
emit "  activate"
emit "  set strayWindow to missing value"
emit "  if not wasRunning then"
emit "    delay 0.5"
emit "    try"
emit "      set strayWindow to front window"
emit "    end try"
emit "  end if"
emit "  set cfg to new surface configuration"

win_var = "win"
config["windows"].each_with_index do |window, wi|
  window["tabs"].each_with_index do |tab, ti|
    layout = tab["layout"]
    cfg0 = new_cfg(first_leaf_cwd(layout))

    if ti.zero?
      emit "  set #{win_var} to new window with configuration #{cfg0}"
      tab_var = "tab#{wi}_#{ti}"
      emit "  set #{tab_var} to selected tab of #{win_var}"
    else
      tab_var = "tab#{wi}_#{ti}"
      emit "  set #{tab_var} to new tab in #{win_var} with configuration #{cfg0}"
    end

    pane0 = new_pane_var
    emit "  set #{pane0} to terminal 1 of #{tab_var}"

    render(layout, pane0, tab_var)

    if layout["panes"] && !layout["panes"].empty?
      emit "  try"
      emit "    perform action \"equalize_splits\" on #{pane0}"
      emit "  end try"
    end

    if tab["title"] && !tab["title"].to_s.strip.empty?
      emit "  try"
      emit "    perform action (\"set_tab_title:\" & #{asq(tab['title'])}) on #{pane0}"
      emit "  end try"
    end

    $focus_tab ||= tab_var
    $focus_pane ||= pane0
  end
end

emit "  if strayWindow is not missing value then"
emit "    try"
emit "      close strayWindow"
emit "    end try"
emit "  end if"
emit "  select tab #{$focus_tab}"
emit "  focus #{$focus_pane}"
emit "end tell"

script = LINES.join("\n")
Tempfile.create(["ghostty-launch", ".applescript"]) do |file|
  file.write(script)
  file.flush
  system("osascript", file.path) || abort("osascript failed")
end
