{
  "files.autoSave": "afterDelay",
  "files.autoGuessEncoding": false,
  "files.encoding": "utf8",
  "files.eol": "\n",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.renderWhitespace": "all",
  "editor.suggestOnTriggerCharacters": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit"
  },
  "editor.formatOnSave": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "eslint.format.enable": true,
  "[prisma]": {
      "editor.defaultFormatter": "Prisma.prisma"
  },
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorTheme": "GitHub Dark",
  "cSpell.languageSettings": [],
  "editor.accessibilitySupport": "off",
  "terminal.external.osxExec": "Ghostty.app",
  "terminal.integrated.allowChords": false,
  "git.autofetch": false,
  "js/ts.tsserver.log": "off",
  "prisma.showPrismaDataPlatformNotification": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "playwright.reuseBrowser": true,
  "vim.easymotion": true,
  "vim.sneak": true,
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "k"],
      "after": ["<Esc>"]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "d"],
      "after": ["d", "d"]
    },
    {
      "before": ["<C-n>"],
      "commands": [":nohl"]
    }
  ],
  "vim.leader": "<space>",
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false
  },
  "vim.surround": true,
  "diffEditor.ignoreTrimWhitespace": true,
  "workbench.editor.enablePreview": false,
  "git.ignoreRebaseWarning": true,
  "git.enableSmartCommit": true,
  "cSpell.userWords": [
    "biomejs",
    "bozuman",
    "clsx",
    "Cmdk",
    "confbox",
    "espree",
    "googleusercontent",
    "kintone",
    "Nuxt",
    "Plasmo",
    "plasmohq",
    "shadcn",
    "sonner",
    "stylelint",
    "svgr",
    "Tekitone",
    "tikurisu",
    "Vite"
  ],
  "editor.minimap.enabled": false,
  "github.copilot.enable": {
    "markdown": true,
    "plaintext": true
  },
  "cursor.cpp.disabledLanguages": [
    "plaintext"
  ],
  "window.commandCenter": true,
  "workbench.settings.applyToAllProfiles": [
      
  ],
  "claudeCode.preferredLocation": "panel",
  "meoEnhanced.editing.preferences": {

    "input": {
      "selectionToolbar": true,
      "wrapSelection": true,
      "pairMode": "smart",
      "skipMode": "smart",
      "deleteMode": "smart",
      "lists": true,
      "convertTables": true,
      "pasteUrl": true,
      "pasteHtml": true,
      "documentSuggestions": true,
      "slash": true,
      "emoji": false
    },
    "shortcuts": {}
  },
  "workbench.editorAssociations": {
    "*.md": "markdownEditorOptimized.editor",
    "*.markdown": "markdownEditorOptimized.editor",
    "*.mdx": "markdownEditorOptimized.editor",
    "*.mdc": "markdownEditorOptimized.editor",
    "git:/**/*.md": "default",
    "git:/**/*.markdown": "default",
    "git:/**/*.mdx": "default",
    "git:/**/*.mdc": "default",
    "git:**/*.md": "default",
    "git:**/*.markdown": "default",
    "git:**/*.mdx": "default",
    "git:**/*.mdc": "default",
    "chat-editing-text-model:/**/*.md": "default",
    "chat-editing-text-model:/**/*.markdown": "default",
    "chat-editing-text-model:/**/*.mdx": "default",
    "chat-editing-text-model:/**/*.mdc": "default",
    "chat-editing-text-model:**/*.md": "default",
    "chat-editing-text-model:**/*.markdown": "default",
    "chat-editing-text-model:**/*.mdx": "default",
    "chat-editing-text-model:**/*.mdc": "default",
    "chat-editing-snapshot-text-model:/**/*.md": "default",
    "chat-editing-snapshot-text-model:/**/*.markdown": "default",
    "chat-editing-snapshot-text-model:/**/*.mdx": "default",
    "chat-editing-snapshot-text-model:/**/*.mdc": "default",
    "chat-editing-snapshot-text-model:**/*.md": "default",
    "chat-editing-snapshot-text-model:**/*.markdown": "default",
    "chat-editing-snapshot-text-model:**/*.mdx": "default",
    "chat-editing-snapshot-text-model:**/*.mdc": "default"
  },
  // MEO theme based on https://qiita.com/evesquare/items/c2118ea8c82784da3f61
  "markdownEditorOptimized.theme": {
    "id": "custom-theme",
    "name": "Custom theme",
    "backgroundColor": "var(--vscode-editor-background)",
    "colors": {
      "base01": "#D4D4D4",
      "base02": "#D4D4D4",
      "base03": "#373737",
      "base04": "#569CD6",
      "base05": "#529CCA",
      "base06": "#4DAB9A",
      "base07": "#E6E6E6",
      "base08": "#FFA344",
      "base09": "#529CCA"
    },
    "syntaxTokens": {},
    "fonts": {
      "liveFont": "",
      "sourceFont": "",
      "liveFontWeight": "",
      "sourceFontWeight": "",
      "liveFontSize": 18,
      "sourceFontSize": 18,
      "h1FontSize": 1.6,
      "h2FontSize": 1.5,
      "h3FontSize": 1.3,
      "h4FontSize": 1.2,
      "h5FontSize": 1.1,
      "h6FontSize": 1,
      "h1FontWeight": "600",
      "h2FontWeight": "600",
      "h3FontWeight": "600",
      "h4FontWeight": "600",
      "h5FontWeight": "600",
      "h6FontWeight": "600",
      "liveLineHeight": 1.5,
      "sourceLineHeight": 1.5
    }
  }
}
